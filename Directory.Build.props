<Project>
	<PropertyGroup>
		<Version>0.5.0</Version>
		<AssemblyVersion>$(Version)</AssemblyVersion>
		<PackageVersion>$(Version)</PackageVersion>
		<Copyright>Shade of Singularity (SoG)</Copyright>
	</PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'GDTask-Debug' Or '$(Configuration)' == 'GDTask-Release'">
    <DefineConstants>GDTask</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'UniTask-Debug' Or '$(Configuration)' == 'UniTask-Release'">
    <DefineConstants>UniTask</DefineConstants>
  </PropertyGroup>
</Project>